{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "score"
    },
    "rig": {
      "type": "object",
      "properties": {
        "width": {
          "$ref": "#/$defs/__schema0"
        },
        "height": {
          "$ref": "#/$defs/__schema0"
        },
        "parts": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        }
      },
      "required": [
        "width",
        "height",
        "parts"
      ],
      "additionalProperties": false
    },
    "score": {
      "type": "object",
      "properties": {
        "pivots": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/__schema5"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema6"
          }
        },
        "attach": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/__schema5"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema5"
          }
        },
        "hidden": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema5"
          }
        },
        "ambient": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema8"
          }
        },
        "follow": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema18"
          }
        },
        "enter": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema19"
            },
            {
              "type": "null"
            }
          ]
        },
        "hover": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema19"
            },
            {
              "type": "null"
            }
          ]
        },
        "click": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema19"
            },
            {
              "type": "null"
            }
          ]
        },
        "look": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "parts": {
                  "minItems": 1,
                  "maxItems": 4,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema5"
                  }
                },
                "range": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 40
                }
              },
              "required": [
                "parts"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "states": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/__schema5"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "enter": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/__schema19"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "ambient": {
                "maxItems": 8,
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema8"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "initialState": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema5"
            },
            {
              "type": "null"
            }
          ]
        },
        "partGain": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/__schema5"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          }
        },
        "liveliness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.5
        },
        "speed": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "rig",
    "score"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000000
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema2"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema2"
            },
            {
              "type": "null"
            }
          ]
        },
        "box": {
          "$ref": "#/$defs/__schema3"
        },
        "background": {
          "type": "boolean"
        },
        "children": {
          "maxItems": 1800,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema3"
          }
        }
      },
      "required": [
        "id",
        "parent",
        "box"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
    },
    "__schema3": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/__schema4"
        },
        {
          "$ref": "#/$defs/__schema4"
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "__schema4": {
      "type": "number",
      "minimum": -1000000,
      "maximum": 1000000
    },
    "__schema5": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
    },
    "__schema6": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/__schema7"
        },
        {
          "$ref": "#/$defs/__schema7"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "__schema7": {
      "type": "number",
      "minimum": -4096,
      "maximum": 4096
    },
    "__schema8": {
      "type": "object",
      "properties": {
        "do": {
          "type": "string",
          "enum": [
            "keys",
            "float",
            "bob",
            "sway",
            "drift",
            "breathe",
            "pulse",
            "spin",
            "orbit",
            "flicker",
            "blink",
            "twinkle",
            "stream",
            "bounce"
          ]
        },
        "part": {
          "$ref": "#/$defs/__schema5"
        },
        "period": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        },
        "phase": {
          "type": "number",
          "minimum": -10,
          "maximum": 10
        },
        "x": {
          "$ref": "#/$defs/__schema7"
        },
        "y": {
          "$ref": "#/$defs/__schema7"
        },
        "deg": {
          "$ref": "#/$defs/__schema7"
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "fade": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "dim": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dx": {
          "$ref": "#/$defs/__schema7"
        },
        "dy": {
          "$ref": "#/$defs/__schema7"
        },
        "stagger": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "reverse": {
          "type": "boolean"
        },
        "keys": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema9"
          }
        }
      },
      "required": [
        "do",
        "part"
      ],
      "additionalProperties": false
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "t": {
          "type": "number",
          "minimum": 0,
          "maximum": 12
        },
        "x": {
          "$ref": "#/$defs/__schema10"
        },
        "y": {
          "$ref": "#/$defs/__schema11"
        },
        "rotate": {
          "$ref": "#/$defs/__schema12"
        },
        "scale": {
          "$ref": "#/$defs/__schema13"
        },
        "scaleX": {
          "$ref": "#/$defs/__schema14"
        },
        "scaleY": {
          "$ref": "#/$defs/__schema15"
        },
        "opacity": {
          "$ref": "#/$defs/__schema16"
        },
        "ease": {
          "$ref": "#/$defs/__schema17"
        }
      },
      "required": [
        "t"
      ],
      "additionalProperties": false
    },
    "__schema10": {
      "$ref": "#/$defs/__schema7"
    },
    "__schema11": {
      "$ref": "#/$defs/__schema7"
    },
    "__schema12": {
      "$ref": "#/$defs/__schema7"
    },
    "__schema13": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 4
    },
    "__schema14": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 4
    },
    "__schema15": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 4
    },
    "__schema16": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "__schema17": {
      "type": "string",
      "enum": [
        "snap",
        "sine",
        "linear",
        "in",
        "out",
        "inOut",
        "back",
        "spring",
        "soft"
      ]
    },
    "__schema18": {
      "type": "object",
      "properties": {
        "part": {
          "$ref": "#/$defs/__schema5"
        },
        "mode": {
          "type": "string",
          "enum": [
            "pendulum",
            "lean",
            "stretch"
          ]
        },
        "period": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 10
        },
        "damping": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "drag": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 50
        },
        "max": {
          "type": "number",
          "minimum": 0,
          "maximum": 90
        },
        "gainX": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "gainY": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      },
      "required": [
        "part"
      ],
      "additionalProperties": false
    },
    "__schema19": {
      "type": "object",
      "properties": {
        "beats": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema20"
          }
        }
      },
      "required": [
        "beats"
      ],
      "additionalProperties": false
    },
    "__schema20": {
      "type": "object",
      "properties": {
        "do": {
          "type": "string",
          "enum": [
            "pop",
            "drop",
            "rise",
            "slideIn",
            "fadeIn",
            "grow",
            "unfold",
            "to",
            "travel",
            "show",
            "hide",
            "fadeOut",
            "wave",
            "wiggle",
            "shake",
            "nod",
            "hop",
            "squash",
            "pulse",
            "spin",
            "lift",
            "burst",
            "flow",
            "drawOn",
            "drawOff"
          ]
        },
        "part": {
          "$ref": "#/$defs/__schema5"
        },
        "at": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "dur": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "ease": {
          "$ref": "#/$defs/__schema17"
        },
        "height": {
          "$ref": "#/$defs/__schema7"
        },
        "deg": {
          "$ref": "#/$defs/__schema7"
        },
        "times": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "px": {
          "$ref": "#/$defs/__schema7"
        },
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "squash": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "turns": {
          "type": "number",
          "minimum": -10,
          "maximum": 10
        },
        "y": {
          "$ref": "#/$defs/__schema7"
        },
        "from": {
          "$ref": "#/$defs/__schema6"
        },
        "points": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema6"
          }
        },
        "turn": {
          "$ref": "#/$defs/__schema7"
        },
        "pose": {
          "type": "object",
          "properties": {
            "x": {
              "$ref": "#/$defs/__schema10"
            },
            "y": {
              "$ref": "#/$defs/__schema11"
            },
            "rotate": {
              "$ref": "#/$defs/__schema12"
            },
            "scale": {
              "$ref": "#/$defs/__schema13"
            },
            "scaleX": {
              "$ref": "#/$defs/__schema14"
            },
            "scaleY": {
              "$ref": "#/$defs/__schema15"
            },
            "opacity": {
              "$ref": "#/$defs/__schema16"
            }
          },
          "additionalProperties": false
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "colors": {
          "maxItems": 6,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema21"
          }
        },
        "shapes": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema22"
          }
        },
        "distance": {
          "$ref": "#/$defs/__schema7"
        },
        "spread": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "angle": {
          "$ref": "#/$defs/__schema7"
        },
        "gravity": {
          "$ref": "#/$defs/__schema7"
        },
        "size": {
          "type": "number",
          "minimum": 0,
          "maximum": 200
        },
        "stagger": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "endScale": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "required": [
        "do"
      ],
      "additionalProperties": false
    },
    "__schema21": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "accent",
            "secondary",
            "ink",
            "background"
          ]
        },
        {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      ]
    },
    "__schema22": {
      "type": "string",
      "enum": [
        "circle",
        "rect",
        "star"
      ]
    }
  }
}
